# Ambiente da Aplicacao
APP_ENV=local
APP_DEBUG=true
APP_VERSION=1.0.0

# Conexao com Banco de Dados
# Opcoes: sqlite ou mysql
DB_DRIVER=sqlite

# Configuracao SQLite (Padrao local - zero configuracao necessaria)
DB_DATABASE=database/database.sqlite

# Configuracao MySQL (Para producao ou servidor local dedicado)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kore_app
DB_USER=root
DB_PASS=

# Multi-Tenancy (standalone ou subdomain)
TENANT_MODE=standalone