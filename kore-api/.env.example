# Ambiente da Aplicação Kodey Kontabs API
APP_ENV=production
APP_DEBUG=false
APP_NAME="Kodey Kontabs API"
APP_VERSION=1.0.0

# Domínio do Frontend para CORS (ex: https://kontabs.kodey.com.br)
FRONTEND_URL=https://kontabs.kodey.com.br

# Conexão com Banco de Dados MySQL
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kontabs
DB_USER=kontabs
DB_PASS=

# Multi-Tenancy (standalone ou subdomain)
TENANT_MODE=standalone

# Google Identity Services / OAuth Credentials
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=